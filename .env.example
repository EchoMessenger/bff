# BFF Service Configuration

# Server
BFF_PORT=7000
LOG_LEVEL=info

# Authentication
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/echo

# Backend Services
AUDIT_SERVICE_URL=http://audit:8080
TASKTRACKER_SERVICE_URL=http://tasktracker:8000
AUDIT_SERVICE_HEALTH_PORT=8081
TASKTRACKER_SERVICE_HEALTH_PORT=8000
AUDIT_SERVICE_HEALTH_PATH=/actuator/health/readiness
TASKTRACKER_SERVICE_HEALTH_PATH=/health

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# CORS
CORS_ALLOWED_ORIGINS=http://192.168.56.1:8080
CORS_ALLOW_CREDENTIALS=false
